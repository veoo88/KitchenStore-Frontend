			}</style><style type="text/css" id="custom-background-css">body.custom-background { background-color: #e2e2e2; }</style><link rel="icon" href="https://thegioidodung.vn/wp-content/uploads/2021/11/favicon-vietmart-60x60.jpg" sizes="32x32" /><link rel="icon" href="https://thegioidodung.vn/wp-content/uploads/2021/11/favicon-vietmart.jpg" sizes="192x192" /><link rel="apple-touch-icon" href="https://thegioidodung.vn/wp-content/uploads/2021/11/favicon-vietmart.jpg" /><meta name="msapplication-TileImage" content="https://thegioidodung.vn/wp-content/uploads/2021/11/favicon-vietmart.jpg" /><style type="text/css" id="wp-custom-css">h1,
h2,
h3,
h4,
h5,
h6 {
	color: #26ABE3;
	line-height: 1.3;
	font-weight: 500;
	margin: 0 0 20px;
}
#secondary {
    width: 30%;
    padding-left: 20px;
    border-left: 1px solid #e9ecef;
}
body {
    font-weight: 400;
    font-size: 16px;
}
.woocommerce ul.products li.product .price {
    color: #009900;
    display: block;
    font-weight: 700;
    margin-bottom: 0.5em;
    font-size: 1.3em;
}
.woocommerce div.product p.price, .woocommerce div.product span.price {
	color: #009900;
	font-weight: 700;
}
.product-info-list {
    color: #FF0000;
    font-weight: bold;
    list-style: bullets;
    padding: 0;
    margin: 0;
}

.product-info-list li {
    margin-bottom: 5px;
}

.policy-link {
    color: #FF0000;
    font-weight: bold;
    text-decoration: none;
}

.policy-link:hover {
    text-decoration: underline;
}
/* Viền đen cho ảnh sản phẩm hết hàng */
.woocommerce ul.products li.product.outofstock img,
.woocommerce div.product.outofstock div.images img {
    border: 3px solid #000;   /* Viền đen */
    box-sizing: border-box;   /* Đảm bảo không làm ảnh lệch */
}
/* Áp dụng kích thước 1.9rem cho tiêu đề này trên tất cả các màn hình */
.tg-page-header .tg-page-header__title {
    /* Đổi font-size từ 2.5rem mặc định sang 1.9rem */
    font-size: 1.9rem !important; 
}
/* Đổi màu chữ tiêu đề sản phẩm ở trang Shop, Danh mục, Archive */
.woocommerce ul.products li.product .woocommerce-loop-product__title {
    color: #035a80 !important;
}
/* CSS của Claude */
/* =============================================
   FUJIHOME BLOG — BỐ CỤC (không can thiệp font theme)
   Paste vào: Appearance → Customize → Additional CSS
   ============================================= */

:root {
  --primary: #0ea5e9;
  --primary-dark: #0284c7;
  --accent: #f97316;
  --accent-light: #fff7ed;
  --text: #1e293b;
  --text-muted: #64748b;
  --bg: #f8fafc;
  --white: #ffffff;
  --border: #e2e8f0;
  --green: #10b981;
  --green-light: #ecfdf5;
  --yellow: #f59e0b;
  --yellow-light: #fffbeb;
  --red: #ef4444;
  --red-light: #fef2f2;
  --radius: 12px;
  --shadow: 0 4px 24px rgba(0,0,0,0.07);
  --shadow-lg: 0 8px 40px rgba(0,0,0,0.12);
}

/* ── HERO ── */
.hero {
  background: linear-gradient(135deg, #0c4a6e 0%, #0ea5e9 60%, #38bdf8 100%);
  padding: 64px 20px 80px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute; inset: 0;
  background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Ccircle cx='30' cy='30' r='20'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}
.hero-badge {
  display: inline-block;
  background: rgba(255,255,255,0.15);
  border: 1px solid rgba(255,255,255,0.3);
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  padding: 6px 16px;
  border-radius: 99px;
  margin-bottom: 20px;
  letter-spacing: 0.5px;
}
.hero h1 {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 800;
  color: #fff !important;
  line-height: 1.25;
  max-width: 780px;
  margin: 0 auto 20px;
}
.hero h1 span { color: #fde68a !important; }
.hero-sub {
  color: rgba(255,255,255,0.85);
  font-size: 1.05rem;
  max-width: 580px;
  margin: 0 auto 32px;
}
.hero-meta {
  display: flex; gap: 24px; justify-content: center; flex-wrap: wrap;
  color: rgba(255,255,255,0.75); font-size: 14px;
}
.hero-meta span { display: flex; align-items: center; gap: 6px; }

/* ── ARTICLE BODY ── */
.article-body {
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 40px 48px;
  margin: -40px auto 40px;
  position: relative;
}
@media(max-width:640px){ .article-body { padding: 28px 20px; } }

/* ── TOC ── */
.toc {
  background: linear-gradient(135deg, #eff6ff, #e0f2fe);
  border-left: 4px solid var(--primary);
  border-radius: var(--radius);
  padding: 24px 28px;
  margin-bottom: 40px;
}
.toc-title {
  font-weight: 700;
  font-size: 15px;
  color: var(--primary-dark);
  margin-bottom: 12px;
  display: flex; align-items: center; gap: 8px;
}
.toc ol { padding-left: 20px; list-style: decimal !important; }
.toc li { margin: 6px 0; list-style: decimal !important; }
.toc a {
  color: var(--primary-dark);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: color .2s;
}
.toc a:hover { color: var(--accent); text-decoration: underline; }

/* ── HEADINGS trong article ── */
.article-body h2 {
  font-size: 1.55rem;
  font-weight: 800;
  color: var(--text) !important;
  margin: 48px 0 16px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--border);
  scroll-margin-top: 80px;
}
.article-body h2::before {
  content: '';
  display: inline-block;
  width: 4px;
  height: 22px;
  background: var(--primary);
  border-radius: 2px;
  margin-right: 10px;
  vertical-align: middle;
}
.article-body h3 {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--primary-dark) !important;
  margin: 32px 0 12px;
  scroll-margin-top: 80px;
}
.article-body p { margin-bottom: 16px; }

/* ── INTRO BOX ── */
.intro-box {
  background: linear-gradient(135deg, #fff7ed, #fef3c7);
  border: 1px solid #fed7aa;
  border-radius: var(--radius);
  padding: 24px 28px;
  margin-bottom: 32px;
  font-size: 1.05rem;
  line-height: 1.8;
}
.intro-box .label {
  font-weight: 700;
  color: var(--accent);
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 8px;
}

/* ── WHY GRID ── */
.why-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin: 20px 0 32px;
}
@media(max-width:560px){ .why-grid { grid-template-columns: 1fr; } }
.why-item {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 16px 18px;
  display: flex; gap: 12px; align-items: flex-start;
}
.why-icon { font-size: 22px; flex-shrink: 0; margin-top: 1px; }
.why-item strong { display: block; font-size: 14px; margin-bottom: 3px; }
.why-item span { font-size: 13px; color: var(--text-muted); }

/* ── PRODUCT CARD ── */
.product-card {
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
  margin: 28px 0;
  box-shadow: var(--shadow);
  transition: box-shadow .2s, transform .2s;
}
.product-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-2px); }
.product-header {
  background: linear-gradient(135deg, #0c4a6e, #0ea5e9);
  padding: 20px 24px;
  display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
}
.product-header h3 {
  color: #fff !important;
  margin: 0 !important;
  font-size: 1.1rem !important;
  border: none !important;
  padding: 0 !important;
}
.product-header h3::before { display: none !important; }
.product-badge {
  background: rgba(255,255,255,0.2);
  border: 1px solid rgba(255,255,255,0.3);
  color: #fff;
  font-size: 12px; font-weight: 600;
  padding: 4px 12px; border-radius: 99px;
  white-space: nowrap;
}
.product-badge.best { background: #f97316; border-color: #f97316; }
.product-body { padding: 22px 24px; }

/* ── SPECS GRID ── */
.specs-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-bottom: 18px;
}
@media(max-width:500px){ .specs-grid { grid-template-columns: 1fr 1fr; } }
.spec-item {
  background: var(--bg);
  border-radius: 8px;
  padding: 10px 12px;
  text-align: center;
}
.spec-label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
.spec-value { font-size: 15px; font-weight: 700; color: var(--text); }

/* ── PROS CONS ── */
.pros-cons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-top: 16px;
}
@media(max-width:480px){ .pros-cons { grid-template-columns: 1fr; } }
.pros { background: var(--green-light); border: 1px solid #a7f3d0; border-radius: 8px; padding: 14px 16px; }
.cons { background: var(--red-light); border: 1px solid #fecaca; border-radius: 8px; padding: 14px 16px; }
.pros-title { font-size: 13px; font-weight: 700; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; color: var(--green); }
.cons-title { font-size: 13px; font-weight: 700; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; color: var(--red); }
.pros ul, .cons ul { padding-left: 16px !important; font-size: 13px; line-height: 1.7; list-style: disc !important; }
.pros ul li, .cons ul li { list-style: disc !important; }

.best-for {
  background: var(--yellow-light);
  border: 1px solid #fde68a;
  border-radius: 8px;
  padding: 10px 16px;
  margin-top: 14px;
  font-size: 13.5px;
}
.best-for strong { color: #92400e; }
.verdict {
  background: linear-gradient(135deg, #eff6ff, #e0f2fe);
  border-radius: 8px;
  padding: 12px 16px;
  margin-top: 14px;
  font-size: 14px;
  font-style: italic;
  color: var(--primary-dark);
}

/* ── TABLE ── */
.table-wrap { overflow-x: auto; margin: 24px 0; border-radius: var(--radius); box-shadow: var(--shadow); }
.table-wrap table { width: 100%; border-collapse: collapse !important; font-size: 14px; background: var(--white); }
.table-wrap thead { background: linear-gradient(135deg, #0c4a6e, #0ea5e9); color: #fff; }
.table-wrap thead th { padding: 13px 14px; text-align: left; font-weight: 600; white-space: nowrap; color: #fff !important; }
.table-wrap tbody tr:nth-child(even) { background: #f8fafc; }
.table-wrap tbody tr:hover { background: #eff6ff; }
.table-wrap tbody td { padding: 12px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }
.tag { display: inline-block; padding: 2px 10px; border-radius: 99px; font-size: 12px; font-weight: 600; white-space: nowrap; }
.tag-green { background: var(--green-light); color: var(--green); }
.tag-blue { background: #eff6ff; color: var(--primary-dark); }
.tag-orange { background: var(--accent-light); color: var(--accent); }

/* ── TIPS LIST ── */
.tips-list { counter-reset: tip; list-style: none !important; padding: 0 !important; margin: 20px 0; }
.tips-list li {
  counter-increment: tip;
  list-style: none !important;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 14px 18px 14px 56px !important;
  margin-bottom: 10px;
  position: relative;
  font-size: 14.5px;
}
.tips-list li::before {
  content: counter(tip) !important;
  position: absolute; left: 18px; top: 50%; transform: translateY(-50%);
  width: 28px; height: 28px;
  background: var(--primary);
  color: #fff; font-weight: 700; font-size: 13px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}

/* ── RECOMMEND GRID ── */
.recommend-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 20px 0; }
@media(max-width:560px){ .recommend-grid { grid-template-columns: 1fr; } }
.recommend-item {
  background: var(--white);
  border: 2px solid var(--border);
  border-radius: 12px;
  padding: 18px 20px;
  transition: border-color .2s;
}
.recommend-item:hover { border-color: var(--primary); }
.recommend-item .need { font-size: 13px; color: var(--text-muted); margin-bottom: 6px; display: flex; align-items: center; gap: 6px; }
.recommend-item .model { font-size: 1.05rem; font-weight: 700; color: var(--primary-dark); margin-bottom: 4px; }
.recommend-item .reason { font-size: 13px; color: var(--text-muted); }

/* ── NOTE BOX ── */
.note-box {
  background: var(--yellow-light);
  border-left: 4px solid var(--yellow);
  border-radius: var(--radius);
  padding: 18px 22px;
  margin: 28px 0;
  font-size: 14.5px;
}
.note-box .note-title { font-weight: 700; color: #92400e; margin-bottom: 6px; }

/* ── CTA BOX ── */
.cta-box {
  background: linear-gradient(135deg, #0c4a6e 0%, #0ea5e9 100%);
  border-radius: 16px;
  padding: 36px 32px;
  text-align: center;
  margin-top: 48px;
  color: #fff;
}
.cta-box h3 {
  font-size: 1.4rem !important;
  font-weight: 800;
  margin-bottom: 10px;
  color: #fff !important;
  border: none !important;
  padding: 0 !important;
}
.cta-box h3::before { display: none !important; }
.cta-box p { color: rgba(255,255,255,0.85) !important; font-size: 15px; margin-bottom: 24px; }
.cta-btn {
  display: inline-block;
  background: var(--accent);
  color: #fff !important;
  font-weight: 700;
  font-size: 15px;
  padding: 13px 32px;
  border-radius: 99px;
  text-decoration: none !important;
  transition: background .2s, transform .2s;
  box-shadow: 0 4px 14px rgba(249,115,22,0.4);
}
.cta-btn:hover { background: #ea6c00; transform: scale(1.03); }

/* ── ARTICLE FOOTER ── */
.article-footer {
  text-align: center;
  padding: 24px 20px;
  font-size: 13px;
  color: var(--text-muted);
  border-top: 1px solid var(--border);
  margin-top: 16px;
}

/* ── FAQ ── */
.faq-item { border: 1px solid var(--border); border-radius: 10px; margin-bottom: 12px; overflow: hidden; }
.faq-q {
  padding: 16px 20px;
  font-weight: 600;
  font-size: 15px;
  background: var(--bg);
  position: relative;
}
.faq-q::after { content: '▾'; position: absolute; right: 18px; top: 50%; transform: translateY(-50%); color: var(--primary); }
.faq-a { padding: 14px 20px; font-size: 14px; border-top: 1px solid var(--border); color: #475569; line-height: 1.75; }</style> <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
